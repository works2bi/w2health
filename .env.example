# W2Health Intelligence — variáveis de ambiente (Docker Compose)
# Copie para .env e preencha os SEGREDOS. O .env é gitignored — nunca versione segredos.
#
# Gerar segredos (Python com `cryptography` instalado, ex.: o venv do backend):
#   python -c "import secrets;print('JWT_SECRET_KEY='+secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet;print('DATA_ENCRYPTION_KEY='+Fernet.generate_key().decode())"
#   python -c "import secrets;print('APP_DB_PASSWORD='+secrets.token_urlsafe(18))"
#   python -c "import secrets;print('PIPELINE_DB_PASSWORD='+secrets.token_urlsafe(18))"
# ou: ./scripts/gen-secrets.ps1  (gera um .env novo, sem sobrescrever o existente)

# ---------------------------------------------------------------- PostgreSQL (dono)
POSTGRES_USER=w2health
POSTGRES_PASSWORD=w2health
POSTGRES_DB=w2health
# Porta no host (publicada só em 127.0.0.1). 15432: a máquina já tem PostgreSQL em 5432/5433.
POSTGRES_PORT=15432

# ---------------------------------------------------------------- papel de runtime da API
# Criado/garantido pela migration de RLS. Sem superusuário, sujeito a Row-Level Security.
APP_DB_ROLE=w2health_app
APP_DB_PASSWORD=

# ---------------------------------------------------------------- papel de PIPELINE (Fase 2)
# Executa ingestão/transformações no data plane do tenant amarrado ao PipelineContext,
# sob RLS (sem superusuário). Criado/garantido pela migration f4c5d6e7a8b9.
PIPELINE_DB_ROLE=w2health_pipeline
PIPELINE_DB_PASSWORD=

# ---------------------------------------------------------------- segredos da aplicação
# Obrigatórios em ENVIRONMENT=production|staging (a API não sobe sem eles).
JWT_SECRET_KEY=
# Chave Fernet (uma ou várias separadas por vírgula para rotação). Cifra segredos MFA e
# credenciais de integração. Sem ela, MFA e o cofre de segredos ficam indisponíveis.
DATA_ENCRYPTION_KEY=
# true obrigatório fora de desenvolvimento (cookie do refresh token só em HTTPS)
COOKIE_SECURE=false
SUPER_ADMIN_REQUIRE_MFA=true

# Rate limit: "database" (compartilhado entre réplicas) ou "memory" (só dev isolado)
RATE_LIMIT_BACKEND=database
# Logs: "json" (estruturado, com tenant/pipeline/correlação) ou "text"
LOG_FORMAT=json

# Senha única para os usuários DEMO criados por `bootstrap-demo` (somente dev local).
# Vazio = senhas aleatórias exibidas uma única vez no terminal.
DEMO_USER_PASSWORD=

# ---------------------------------------------------------------- portas expostas no host
# Backend em 8010: o Docker Desktop ocupa a 8000 nesta máquina.
BACKEND_PORT=8010
FRONTEND_PORT=3000

# Backend — origens de CORS. É uma coleção: informe como array JSON válido.
CORS_ORIGINS=["http://localhost:3000"]

# ---- Alertas por e-mail (Evolução, item 4). Sem SMTP_HOST o envio é SIMULADO (.eml no outbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=W2Health <alertas@w2health.local>
# NOTIFICACOES_OUTBOX_DIR=/tmp/w2health-outbox
APP_PUBLIC_URL=http://localhost:3000
