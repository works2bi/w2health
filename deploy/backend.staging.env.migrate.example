# Modelo do backend/.env.migrate da VPS — docs/DEPLOY_VPS.md. Lido SÓ pelo passo de migration
# do deploy (deploy/remote_deploy_staging.sh), em subshell: API e worker não recebem o papel
# dono. Copiar para /srv/apps/w2data_w2health/staging/backend/.env.migrate (chmod 600).
# É carregado como shell: mantenha as aspas.

DATABASE_ADMIN_URL="postgresql+psycopg://w2health_stg_owner:<senha_owner>@/w2health_stg?host=127.0.0.1"
APP_DB_ROLE="w2health_stg_app"
PIPELINE_DB_ROLE="w2health_stg_pipeline"
# papéis criados pelo DBA; as migrations só verificam (sem CREATE/ALTER ROLE)
DB_ROLES_PROVISIONED="true"
