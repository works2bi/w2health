# Modelo do backend/.env da VPS (staging/demonstração) — docs/DEPLOY_VPS.md.
# Copiar para /srv/apps/w2data_w2health/staging/backend/.env (chmod 600) e trocar TODOS
# os <...>. Nunca versionar o arquivo preenchido.
#
# NÃO colocar DATABASE_ADMIN_URL aqui: API e worker não usam o papel dono. Ela fica em
# backend/.env.migrate (modelo: deploy/backend.staging.env.migrate.example).

ENVIRONMENT=staging
LOG_FORMAT=json

# Banco: host na query (?host=127.0.0.1) — a config de staging recusa "@localhost"/"@127.0.0.1"
# na URL; este formato conecta via TCP local como os outros apps (sem mudar o pg_hba).
# Papéis criados pelo DBA (sem SUPERUSER/BYPASSRLS/CREATEROLE/CREATEDB).
DATABASE_URL=postgresql+psycopg://w2health_stg_app:<senha_app>@/w2health_stg?host=127.0.0.1
DATABASE_PIPELINE_URL=postgresql+psycopg://w2health_stg_pipeline:<senha_pipeline>@/w2health_stg?host=127.0.0.1
APP_DB_ROLE=w2health_stg_app
PIPELINE_DB_ROLE=w2health_stg_pipeline

# Segredos — gerar com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   (Fernet)
JWT_SECRET_KEY=<token_urlsafe_48>
DATA_ENCRYPTION_KEY=<chave_fernet>

# Origem pública única (mesma origem do frontend; a API fica em /api)
CORS_ORIGINS=["https://stg-w2health.works2data.com.br"]
TRUSTED_HOSTS=["stg-w2health.works2data.com.br"]
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
FORWARDED_ALLOW_IPS=127.0.0.1

# RAW em disco local (diretório próprio, fora do que o deploy sobrescreve)
RAW_STORAGE_BACKEND=local
RAW_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true
RAW_STORAGE_ROOT=/srv/apps/w2data_w2health/staging/data/raw

# Limites menores para a demonstração (o nginx aceita até 110 MB só na rota de upload)
UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_FILES=5
REQUEST_MAX_BODY_KB=1024
